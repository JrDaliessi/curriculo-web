# Token fine-grained de somente leitura, restrito aos repositórios privados selecionados.
GITHUB_ACTIVITY_TOKEN=

# Objeto JSON mantido somente no servidor. Exemplo:
# {"fincontrol":"owner/private-repo","clube":"owner/private-repo"}
GITHUB_ACTIVITY_REPOSITORIES_JSON=

# Credenciais públicas da conta demonstrativa do FinControl, mantidas no servidor.
FINCONTROL_DEMO_EMAIL=
FINCONTROL_DEMO_PASSWORD=
